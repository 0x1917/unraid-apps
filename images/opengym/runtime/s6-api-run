#!/bin/sh
# The openGym API: the only process that touches /data. s6-setuidgid drops
# pid-1's privileges before exec, so node runs as opengym (uid 99).
#
# The marker branch below is a hook for images layered ON this one: a layer
# that needs the API as root (so processes it spawns can drop to an
# unprivileged user) bakes the marker into the image, and the data dir it
# brings is handed to its unprivileged user here. A baked marker rather than
# an env var on purpose: an env switch could be flipped at run time and would
# silently undo the privilege drop.
cd /app
if [ -f /etc/opengym/coach-enabled ]; then
	# A bound auth dir arrives with the host owner (root or nobody:users);
	# hand it to the layer's unprivileged user before the server starts.
	[ -d /coach-auth ] && chown coach:coach /coach-auth 2>/dev/null
	exec node server.js
fi
exec s6-setuidgid opengym node server.js
